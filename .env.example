# ---------------------------------------------------------------------------
# Agent Relay configuration. Copy to .env and edit.  NEVER commit .env.
# ---------------------------------------------------------------------------

# --- Server -----------------------------------------------------------------
AGENT_RELAY_HOST=127.0.0.1
AGENT_RELAY_PORT=8077
AGENT_RELAY_DB_URL=sqlite:///./data/agent_relay.db
AGENT_RELAY_LOG_LEVEL=INFO

# --- Context tuning ---------------------------------------------------------
# Defaults for GET /context and GET /coordination/summary when the caller omits them.
AGENT_RELAY_CONTEXT_LIMIT=10
AGENT_RELAY_CONTEXT_WINDOW_HOURS=72

# --- Optional shared auth token ---------------------------------------------
# If set, every request must send:  Authorization: Bearer <token>
# Leave empty to disable auth (fine on a trusted LAN / VPN / localhost).
AGENT_RELAY_API_TOKEN=

# --- Slack: outbound (optional) ---------------------------------------------
# Incoming webhook URL. If unset, Slack posting is silently disabled.
SLACK_WEBHOOK_URL=
# Comma-separated event types to forward. Empty = all event types.
SLACK_EVENT_TYPES=
SLACK_TIMEOUT_SECONDS=5.0

# --- Slack: bidirectional bot (optional) ------------------------------------
# A bot token makes Slack two-way: chat.postMessage returns a message ts, which is
# how a human's threaded reply becomes an ANSWER event in the relay.
# Needs scopes: chat:write, channels:history (or groups:history for private channels).
SLACK_BOT_TOKEN=
# Required to accept inbound Slack events. From the app's "Basic Information" page.
SLACK_SIGNING_SECRET=
# Channel used when a project has no channel of its own.
SLACK_DEFAULT_CHANNEL=
# Per-project routing: "tether=C012AB,drends=C034CD"
SLACK_CHANNEL_MAP=

# --- GitHub (optional) ------------------------------------------------------
# Used only to build links and (optionally) read issue/PR metadata.
# A read-only fine-grained token is enough. The relay never writes to GitHub.
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
# Prefix that turns a task id into an issue number: GH-142 -> issue 142
GITHUB_TASK_PREFIX=GH-

# --- GitHub ingestion (optional) --------------------------------------------
# Enables POST /webhooks/github. Must match the secret set on the GitHub webhook.
GITHUB_WEBHOOK_SECRET=
# Project that ingested GitHub activity is filed under (defaults to GITHUB_REPO).
GITHUB_INGEST_PROJECT=
# Polling fallback for relays with no publicly reachable URL. 0 disables it.
GITHUB_POLL_INTERVAL_SECONDS=0

# --- Presence and claim hygiene ---------------------------------------------
# How fresh a heartbeat must be to count as online, then as merely idle.
AGENT_RELAY_HEARTBEAT_ONLINE_SECONDS=300
AGENT_RELAY_HEARTBEAT_IDLE_SECONDS=1800
# A claim with no activity for this long is reported as stale.
AGENT_RELAY_CLAIM_STALE_HOURS=24
# Auto-release a stale claim after this long. 0 = never auto-release, only report.
AGENT_RELAY_CLAIM_EXPIRY_HOURS=0
# How often the background sweeper runs. 0 disables it.
AGENT_RELAY_SWEEPER_INTERVAL_SECONDS=300

# --- Coordinator LLM (optional) ---------------------------------------------
# Leave this blank unless you have Anthropic *API* access. A Claude subscription
# (Pro/Max) powers Claude Code, not the API, so most teams will have nothing to put
# here — and that is a supported configuration, not a degraded one:
# /coordination/brief and `agent-relay brief` return a rule-based briefing that names
# who is working, what is blocked, what is unanswered and what to do next.
#
# If you want prose without paying per token, let one of your own agents write it:
#   agent-relay summary --project tether --json
# is ~900 characters and is designed to be handed straight to an agent that already
# has a subscription. See docs/OPERATIONS.md.
#
# Needs the extra:  uv sync --extra coordinator
ANTHROPIC_API_KEY=
# The SDK also accepts a bearer token, or an `ant auth login` profile on disk.
ANTHROPIC_AUTH_TOKEN=
# Force the coordinator on when the credential is on disk rather than in the env.
AGENT_RELAY_COORDINATOR=false
COORDINATOR_MODEL=claude-opus-5
COORDINATOR_MAX_TOKENS=16000
# low | medium | high | xhigh | max
COORDINATOR_EFFORT=low
# Post a team status to Slack on a cadence. 0 disables it.
AGENT_RELAY_STATUS_INTERVAL_MINUTES=0
AGENT_RELAY_STATUS_PROJECTS=

# --- Experiment trackers (optional, link-only) ------------------------------
# Lets "wandb:<run_id>" / "mlflow:<run_id>" artifacts become clickable links.
WANDB_ENTITY=
WANDB_PROJECT=
MLFLOW_TRACKING_URI=

# --- Dashboard and discovery ------------------------------------------------
AGENT_RELAY_DASHBOARD=true
# Absolute URL this relay is reachable at. Used in the A2A agent card.
AGENT_RELAY_PUBLIC_URL=

# --- Client / CLI identity --------------------------------------------------
AGENT_RELAY_URL=http://127.0.0.1:8077
AGENT_NAME=leo-codex
HUMAN_OWNER=leonardo
